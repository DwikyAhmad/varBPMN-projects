  <bpmn2:process id="Process_1" name="Deposit Process" isExecutable="false">
    <bpmn2:startEvent id="StartEvent_3" name="Start Event 3">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="Task_InitAmount" name="init int amount as (int) requestBody.get(&quot;amount&quot;)" scriptFormat="java">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_PutIdUser" name="requestBody.put(&quot;id_user&quot;, requestBody.get(&quot;targetUserId&quot;))" scriptFormat="java">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_GetAccount" name="HashMap&lt;String, Object> account = accountAccountsService.getAccount(requestBody)" scriptFormat="java">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_InitBalance" name="init int balance as (int) account.get(&quot;balance&quot;)" scriptFormat="java">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_10</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_InitCurrency" name="init String currency as (String) requestBody.get(&quot;currency&quot;)" scriptFormat="java">
      <bpmn2:incoming>SequenceFlow_10</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="Gateway_Currency" name="Exclusive Gateway" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_8</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="Task_Mult1" name="mult amount with 1" scriptFormat="java">
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_Mult2" name="mult amount with 2" scriptFormat="java">
      <bpmn2:incoming>Flow_8</bpmn2:incoming>
      <bpmn2:outgoing>Flow_11</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_Mult3" name="mult amount with 3" scriptFormat="java">
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
      <bpmn2:outgoing>Flow_12</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="Gateway_Merge" name="Exclusive Gateway" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
      <bpmn2:incoming>Flow_11</bpmn2:incoming>
      <bpmn2:incoming>Flow_12</bpmn2:incoming>
      <bpmn2:outgoing>Flow_13</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="Task_AddAmountToBalance" name="add amount to balance" scriptFormat="java">
      <bpmn2:incoming>Flow_13</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_PutBalanceToAccount" name="put balance to account" scriptFormat="java">
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
      <bpmn2:outgoing>Flow_15</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_UpdateAccount" name="accountAccountsService.updateAccount(account)" scriptFormat="java">
      <bpmn2:incoming>Flow_15</bpmn2:incoming>
      <bpmn2:outgoing>Flow_16</bpmn2:outgoing>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="EndEvent_7" name="End Event 7">
      <bpmn2:incoming>Flow_16</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_3" targetRef="Task_InitAmount"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_InitAmount" targetRef="Task_PutIdUser"/>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_PutIdUser" targetRef="Task_GetAccount"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_GetAccount" targetRef="Task_InitBalance"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Task_InitCurrency" targetRef="Gateway_Currency"/>
    <bpmn2:sequenceFlow id="Flow_7" name="currency equals (&quot;IDR&quot;)" sourceRef="Gateway_Currency" targetRef="Task_Mult1">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="FormalExpression_1">currency == &quot;IDR&quot;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_8" name="currency equals (&quot;USD&quot;)" sourceRef="Gateway_Currency" targetRef="Task_Mult2">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="FormalExpression_2">currency == &quot;USD&quot;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_9" name="currency equals (&quot;JPY&quot;)" sourceRef="Gateway_Currency" targetRef="Task_Mult3">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="FormalExpression_3">currency == &quot;JPY&quot;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Task_Mult1" targetRef="Gateway_Merge"/>
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Task_Mult2" targetRef="Gateway_Merge"/>
    <bpmn2:sequenceFlow id="Flow_12" sourceRef="Task_Mult3" targetRef="Gateway_Merge"/>
    <bpmn2:sequenceFlow id="Flow_13" sourceRef="Gateway_Merge" targetRef="Task_AddAmountToBalance"/>
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="Task_AddAmountToBalance" targetRef="Task_PutBalanceToAccount"/>
    <bpmn2:sequenceFlow id="Flow_15" sourceRef="Task_PutBalanceToAccount" targetRef="Task_UpdateAccount"/>
    <bpmn2:sequenceFlow id="Flow_16" sourceRef="Task_UpdateAccount" targetRef="EndEvent_7"/>
    <bpmn2:sequenceFlow id="SequenceFlow_10" sourceRef="Task_InitBalance" targetRef="Task_InitCurrency"/>
  </bpmn2:process>
